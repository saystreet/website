---
import { DEMO_URL } from '../data/site';
---

<section aria-labelledby="closing-title" class="border-t border-line py-24 text-center lg:py-32">
	<h2 id="closing-title" class="mx-auto max-w-[12em] text-[clamp(2.5rem,5.4vw,4.5rem)] leading-[0.92] font-black">
		Try it in under a minute.
	</h2>
	<p class="mx-auto mt-5 max-w-[34em] text-lg leading-relaxed text-ink-muted sm:text-xl">
		No email, no password. You get a sandbox PayPal wallet, a demo address and a few sample orders.
	</p>
	<a href={DEMO_URL} class="mt-9 inline-flex min-h-12 items-center forced-colors:border-2 rounded-full bg-ink px-9 py-4 text-lg font-bold text-accent-ink">Try the demo</a>
</section>
