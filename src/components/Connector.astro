---
interface Props {
	label: string;
}
const { label } = Astro.props;
---

<div class="flex min-h-16 items-center gap-4 pl-[calc(50%-0.5px)] xl:min-h-0 xl:flex-col xl:justify-center xl:gap-0 xl:px-2">
	<span aria-hidden="true" class="h-16 w-px bg-line xl:order-2 xl:mt-2 xl:h-px xl:w-full"></span>
	<span class="text-sm leading-tight text-ink-muted xl:order-1 xl:text-center">{label}</span>
</div>
