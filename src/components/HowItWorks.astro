---
import { DEVPOST_URL, SITE_NAME } from '../data/site';
import ExternalLink from './ExternalLink.astro';
import Connector from './Connector.astro';
import Icon from './Icon.astro';
import Section from './Section.astro';

const partners = [
	{ name: 'PayPal', uses: 'Vault, Orders, Payments, Webhooks' },
	{ name: 'Channel3', uses: 'Product search, product by link' },
	{ name: 'Render', uses: 'Hosting and database' },
];
const card = 'rounded-(--radius-panel) border bg-surface-2 p-6';
---

<Section id="how" title="How it works.">
	<Fragment slot="intro">
		Built for the <ExternalLink href={DEVPOST_URL} class="underline underline-offset-4 hover:text-ink">PayPal AI Hackathon</ExternalLink>.
	</Fragment>
	<div class="mx-auto grid max-w-xl gap-0 xl:max-w-none xl:grid-cols-[1fr_8rem_1.3fr_8rem_1.2fr] xl:items-center">
		<div class:list={[card, 'border-line']}>
			<div class="flex items-center gap-3">
				<Icon name="microphone" />
				<h3 class="text-2xl leading-tight font-bold">You</h3>
			</div>
			<p class="mt-4 text-base leading-relaxed text-ink-muted">Speak or type. Every action has its own short sound.</p>
		</div>

		<Connector label="Messages and replies" />

		<div class:list={[card, 'border-accent/70']}>
			<h3 class="text-2xl leading-tight font-bold">{SITE_NAME}</h3>
			<div class="mt-4 divide-y divide-line">
				<div class="py-5 first:pt-0 last:pb-0">
					<div class="flex items-center gap-3">
						<Icon name="chat" ours />
						<div>
							<h4 class="font-display text-xl leading-tight font-black uppercase">Agent</h4>
							<p class="text-sm text-ink-muted">Language model</p>
						</div>
					</div>
					<p class="mt-3 text-base leading-relaxed text-ink-muted">
						Understands you, searches, and answers from the product listing. It can propose a purchase, but it can’t pay.
					</p>
				</div>
				<div class="py-5 first:pt-0 last:pb-0">
					<div class="flex items-center gap-3">
						<Icon name="shield" ours />
						<div>
							<h4 class="font-display text-xl leading-tight font-black uppercase">Checks</h4>
							<p class="text-sm text-ink-muted">Plain code, not the model</p>
						</div>
					</div>
					<p class="mt-3 text-base leading-relaxed text-ink-muted">
						Confirms the amount you said, your limits and the live price before PayPal is asked.
					</p>
				</div>
			</div>
		</div>

		<Connector label="Products, payments, voice" />

		<div class:list={[card, 'border-line']}>
			<div class="flex items-center gap-3">
				<Icon name="plugs" />
				<h3 class="text-2xl leading-tight font-bold">Partners</h3>
			</div>
			<dl class="mt-4 divide-y divide-line">
				{
					partners.map((p) => (
						<div class="py-3 first:pt-0 last:pb-0">
							<dt class="font-display text-xl leading-tight font-black uppercase">{p.name}</dt>
							<dd class="mt-0.5 text-base text-ink-muted">{p.uses}</dd>
						</div>
					))
				}
			</dl>
			<p class="mt-4 border-t border-line pt-4 text-sm text-ink-muted">AI model: OpenAI. Agent, speech-to-text, voice.</p>
		</div>
	</div>
</Section>
