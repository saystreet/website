---
import Base from '../layouts/Base.astro';
import { SITE_NAME } from '../data/site';
---

<Base title={`Not found | ${SITE_NAME}`} description="This page does not exist." noindex>
	<main id="main" class="mx-auto max-w-3xl px-6 py-24">
		<p class="data text-ink-muted">404</p>
		<h1 class="mt-3 text-6xl leading-none font-black">This page does not exist.</h1>
		<a href="/" class="mt-8 inline-block text-lg underline underline-offset-4">Go to saystreet.app</a>
	</main>
</Base>
