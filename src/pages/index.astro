---
import Base from '../layouts/Base.astro';
import Closing from '../components/Closing.astro';
import Conversation from '../components/Conversation.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Problem from '../components/Problem.astro';
import { SITE_DESCRIPTION, SITE_NAME } from '../data/site';
---

<Base title={SITE_NAME} description={SITE_DESCRIPTION} ogImage="/og.png">
	<a
		href="#main"
		class="skip-link fixed top-4 left-4 z-50 rounded-(--radius-control) bg-ink px-4 py-3 font-semibold text-accent-ink"
	>
		Skip to main content
	</a>
	<div class="mx-auto max-w-[100rem] px-6 sm:px-12 lg:px-20">
		<Header />
		<main id="main" tabindex="-1">
			<Hero />
			<Problem />
			<Conversation />
			<HowItWorks />
			<Closing />
		</main>
		<Footer />
	</div>
</Base>
